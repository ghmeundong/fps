{
  "name": "fps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@types/three": "^0.185.4",
    "gsap": "^3.15.0",
    "three": "^0.186.0"
  },
  "build": {
    "appId": "com.aimlab.fps",
    "productName": "AIM LAB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  }
}
